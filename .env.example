# XyoLua GameForge — example configuration.
# Copy to `.env` (which is git-ignored) and fill in your own values.
# GameForge never ships keys and never sends data anywhere except the provider you choose.

# Which AI provider to use: anthropic | openai-compatible | ollama | mock
AI_PROVIDER=anthropic

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=your_key_here
# ANTHROPIC_MODEL=claude-opus-5-5

# --- OpenAI-compatible (OpenAI, OpenRouter, Groq, LM Studio, vLLM, ...) ----
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=your-model

# --- Ollama (local, no key needed) -----------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=your-model

# --- Godot -----------------------------------------------------------------
# Absolute path to the Godot 4 executable if it is not on your PATH.
# GODOT_PATH=C:\Tools\Godot\Godot_v4.7.2-stable_win64.exe

# --- Misc ------------------------------------------------------------------
# GAMEFORGE_LOG_LEVEL=info
