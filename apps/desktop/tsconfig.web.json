{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@gameforge/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src/renderer/src", "src/shared", "src/renderer/test"]
}
