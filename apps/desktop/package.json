    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@gameforge/core": "workspace:*",
    "@gameforge/godot": "workspace:*",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.1",
