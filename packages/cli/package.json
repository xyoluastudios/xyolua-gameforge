{
  "name": "@gameforge/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The gameforge command line interface.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@gameforge/core": "workspace:*",
    "@gameforge/godot": "workspace:*",
    "@gameforge/mcp": "workspace:*"
  },
  "bin": {
    "gameforge": "./dist/bin.js"
  }
}
