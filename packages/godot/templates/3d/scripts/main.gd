extends Node3D
## Game scene (3D). Builds the world from the level data and wires up the
## player, enemies, HUD and menus. Generated by XyoLua GameForge.

const LevelBuilder := preload("res://scripts/world/level_builder.gd")
const RandomEvents := preload("res://scripts/world/random_events.gd")

@onready var level: LevelBuilder = $Level
@onready var player: CharacterBody3D = $Player


func _ready() -> void:
	get_tree().paused = false
	GameState.reset()
	_setup_environment()
	level.build()
	player.global_position = level.spawn_position()
	player.rotation.y = level.spawn_rotation()
	if GameState.has_feature("enemy_ai"):
		level.spawn_enemies()
	if GameState.has_feature("random_events"):
		var events := RandomEvents.new()
		events.name = "RandomEvents"
		add_child(events)
	if GameState.has_feature("ambient_audio"):
		AudioManager.start_ambience()
	GameState.post_message(GameState.get_text("intro", "Find the way out."))
	if SaveSystem.load_on_start:
		SaveSystem.load_on_start = false
		SaveSystem.load_game()


func _setup_environment() -> void:
	var environment := Environment.new()
	environment.background_mode = Environment.BG_COLOR
	environment.background_color = Color(0.01, 0.01, 0.015)
	environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	environment.ambient_light_color = Color(0.55, 0.58, 0.62)
	environment.ambient_light_energy = float(GameState.get_setting("world", "ambient_light", 0.4))
	environment.tonemap_mode = Environment.TONE_MAPPER_ACES
	var fog_density := float(GameState.get_setting("world", "fog_density", 0.0))
	if fog_density > 0.0:
		environment.fog_enabled = true
		environment.fog_density = fog_density
		environment.fog_light_color = Color(0.04, 0.045, 0.05)
	var world_environment := WorldEnvironment.new()
	world_environment.environment = environment
	add_child(world_environment)
