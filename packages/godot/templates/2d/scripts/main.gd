extends Node2D
## Game scene (2D top-down). Builds the world from the level data and wires
## up the player, enemies, HUD and menus. Generated by XyoLua GameForge.

const LevelBuilder := preload("res://scripts/world/level_builder.gd")
const RandomEvents := preload("res://scripts/world/random_events.gd")

@onready var level: LevelBuilder = $Level
@onready var player: CharacterBody2D = $Player


func _ready() -> void:
	get_tree().paused = false
	GameState.reset()
	RenderingServer.set_default_clear_color(Color.html(str(GameState.get_setting("world", "background_color", "#0d0e11"))))
	var tint := CanvasModulate.new()
	tint.name = "WorldTint"
	tint.color = Color.html(str(GameState.get_setting("world", "tint", "#ffffff")))
	tint.add_to_group("world_tint")
	add_child(tint)
	level.build()
	player.global_position = level.spawn_position()
	if GameState.has_feature("enemy_ai"):
		level.spawn_enemies()
	if GameState.has_feature("random_events"):
		var events := RandomEvents.new()
		events.name = "RandomEvents"
		add_child(events)
	if GameState.has_feature("ambient_audio"):
		AudioManager.start_ambience()
	GameState.post_message(GameState.get_text("intro", "Find the way out."))
	if SaveSystem.load_on_start:
		SaveSystem.load_on_start = false
		SaveSystem.load_game()
